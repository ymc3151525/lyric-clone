<Window x:Class="LyricClone.App.Views.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Width="1120" Height="720" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static ApplicationCommands.Find}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="OnFind" />
    </Window.CommandBindings>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TrackColumn" />
            <ColumnDefinition x:Name="SourcesColumn" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Tracks (All Tracks only) -->
        <DockPanel x:Name="TrackPane" Grid.Column="0" Margin="0,0,12,0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="全部曲目" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource Button.Subtle}" Content="刷新曲目库" Click="OnRefreshLibrary" />
            </Grid>
            <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                     AutomationProperties.Name="搜索歌名、艺人或专辑" ToolTip="搜索歌名、艺人或专辑（Ctrl+F）" />
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox SelectedIndex="{Binding FilterIndex}" AutomationProperties.Name="筛选">
                    <ComboBoxItem Content="全部" />
                    <ComboBoxItem Content="已固定版本" />
                    <ComboBoxItem Content="未固定版本" />
                    <ComboBoxItem Content="含本地歌词" />
                    <ComboBoxItem Content="已存 LRCLIB" />
                </ComboBox>
                <ComboBox Grid.Column="2" SelectedIndex="{Binding SortIndex}" AutomationProperties.Name="排序">
                    <ComboBoxItem Content="最近播放" />
                    <ComboBoxItem Content="最近管理" />
                    <ComboBoxItem Content="标题" />
                </ComboBox>
            </Grid>
            <Border Style="{StaticResource Card}" Padding="4">
                <ListBox x:Name="TrackList" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}"
                         BorderThickness="0" Background="Transparent" VirtualizingPanel.IsVirtualizing="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,4">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                <TextBlock Style="{StaticResource Text.Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           Text="{Binding Converter={StaticResource TrackSubtitle}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>

        <!-- Sources -->
        <DockPanel x:Name="SourcesPane" Grid.Column="1" Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="{Binding TrackHeader}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding TrackDetails}" />
            </StackPanel>
            <Grid DockPanel.Dock="Top" Margin="0,4,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="歌词来源" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource Button.Icon}" Content="?" ToolTip="查看选择规则" AutomationProperties.Name="查看选择规则" Click="OnRules" />
                <Button x:Name="AddButton" Grid.Column="2" Style="{StaticResource Button.Secondary}" Content="添加歌词 ▾" Click="OnAddMenu" Margin="4,0,0,0">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="导入本地歌词文件…" Click="OnImportFile" />
                            <MenuItem Header="从文本添加歌词…" Click="OnAddFromText" />
                            <Separator />
                            <MenuItem Header="通过 LRCLIB ID 或链接指定版本…" Click="OnById" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
            <Border Style="{StaticResource Card}" Padding="4">
                <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource Text.Muted}" Margin="8,0,0,0" />
                                </Grid>
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,4" />
                                <ItemsControl ItemsSource="{Binding Labels}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Chip" Style="{StaticResource Badge}">
                                                <TextBlock x:Name="ChipText" Text="{Binding Text}" Style="{StaticResource Text.Muted}" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsAccent}" Value="True">
                                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>

        <!-- Version detail + preview -->
        <DockPanel Grid.Column="2">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button x:Name="PrimaryButton" Style="{StaticResource Button.Primary}" Margin="0,0,8,8" Click="OnPrimary" />
                <Button x:Name="SecondaryButton" Margin="0,0,8,8" Click="OnSecondary" />
                <Button x:Name="ChangeButton" Margin="0,0,8,8" Click="OnChangeMenu">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="搜索并选择版本…" Click="OnSearch" />
                            <MenuItem x:Name="AutoReplaceItem" Header="自动搜索并替换" Click="OnAutoReplace" />
                            <MenuItem Header="通过 ID 或链接指定版本…" Click="OnById" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="PreviewButton" Content="效果预览" Margin="0,0,8,8" Click="OnPreview" />
                <Button x:Name="MoreButton" Content="更多 ···" Margin="0,0,8,8" Click="OnMoreMenu" AutomationProperties.Name="更多操作">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="OffsetItem" Header="调整歌词偏移…" Click="OnPreview" />
                            <MenuItem x:Name="RefetchItem" Header="重新获取此版本的歌词" Click="OnRefetch" />
                            <MenuItem x:Name="EditItem" Header="编辑本地歌词…" Click="OnEdit" />
                            <MenuItem x:Name="RenameItem" Header="重命名…" Click="OnRename" />
                            <Separator />
                            <MenuItem x:Name="DeleteItem" Header="删除此版本" Click="OnDelete" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </WrapPanel>

            <Border x:Name="InfoBar" DockPanel.Dock="Top" Margin="0,0,0,8" Padding="12,8" CornerRadius="{StaticResource Radius.Md}"
                    Background="{DynamicResource Brush.AccentSubtle}" Visibility="Collapsed">
                <TextBlock x:Name="InfoText" Style="{StaticResource Text.Body}" />
            </Border>

            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding SelectedLabels}" Margin="0,0,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Badge}"><TextBlock Text="{Binding Text}" Style="{StaticResource Text.Muted}" /></Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid>
                <Border Style="{StaticResource Card}" Padding="0">
                    <ListBox ItemsSource="{Binding Preview}" BorderThickness="0" Background="Transparent" Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="12">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem"><ContentPresenter Margin="0,3" /></ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Text.Muted}" FontFamily="{StaticResource Font.Mono}" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Body}" />
                                        <TextBlock Text="{Binding Translation}" Style="{StaticResource Text.Muted}">
                                            <TextBlock.Visibility>
                                                <Binding Path="Translation" Converter="{StaticResource NullToCollapsed}" />
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
                    <Path Data="{StaticResource Icon.Music}" Width="32" Height="32" Stretch="Uniform" StrokeThickness="2"
                          Stroke="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyText" Margin="0,12,0,0" TextAlignment="Center" Style="{StaticResource Text.Muted}" FontSize="{StaticResource Type.Body.Size}" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
