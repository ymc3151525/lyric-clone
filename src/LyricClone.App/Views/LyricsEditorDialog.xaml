<Window x:Class="LyricClone.App.Views.LyricsEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="编辑本地歌词"
        Width="760" Height="620" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="24">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Body}" Text="版本名称" Margin="0,0,0,6" />
                <TextBox x:Name="NameBox" AutomationProperties.Name="版本名称" TextChanged="OnChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource Text.Body}" Text="格式" Margin="0,0,0,6" />
                <ComboBox x:Name="FormatBox" SelectedIndex="0" SelectionChanged="OnChanged" AutomationProperties.Name="格式">
                    <ComboBoxItem Content="自动识别" />
                    <ComboBoxItem Content="LRC" />
                    <ComboBoxItem Content="TTML" />
                    <ComboBoxItem Content="QRC" />
                    <ComboBoxItem Content="KRC" />
                    <ComboBoxItem Content="YRC" />
                    <ComboBoxItem Content="Lyricify Lines" />
                    <ComboBoxItem Content="Lyricify Syllable" />
                    <ComboBoxItem Content="纯文本（无时间轴）" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Style="{StaticResource Text.Body}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Content="取消" IsCancel="True" MinWidth="88" Margin="8,0,8,0" />
            <Button x:Name="SaveButton" Grid.Column="2" Style="{StaticResource Button.Primary}" Content="保存" MinWidth="88" Click="OnSave" />
        </Grid>

        <TabControl>
            <TabItem Header="歌词">
                <TextBox x:Name="ContentBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         FontFamily="{StaticResource Font.Mono}" TextChanged="OnChanged" AutomationProperties.Name="歌词内容" />
            </TabItem>
            <TabItem Header="翻译（可选）">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Muted}" Margin="0,8,0,8" TextWrapping="Wrap"
                               Text="用 LRC 格式填写，时间和歌词行对得上的会显示为翻译。" />
                    <TextBox x:Name="TranslationBox" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             FontFamily="{StaticResource Font.Mono}" TextChanged="OnChanged" AutomationProperties.Name="翻译内容" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
