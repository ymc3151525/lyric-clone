<Window x:Class="LyricClone.App.Views.SearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="搜索并选择版本"
        Width="920" Height="600" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Subtitle}" Text="在 LRCLIB 中搜索" />
        <TextBlock x:Name="TrackText" DockPanel.Dock="Top" Style="{StaticResource Text.Muted}" Margin="0,4,0,12" />

        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QueryBox" AutomationProperties.Name="搜索关键词" KeyDown="OnQueryKey" />
            <Button x:Name="SearchButton" Grid.Column="1" Style="{StaticResource Button.Primary}" Content="搜索" MinWidth="88" Margin="8,0,0,0" Click="OnSearch" />
        </Grid>

        <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="WarningText" Foreground="{DynamicResource Brush.Warning}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="取消" IsCancel="True" MinWidth="88" Margin="8,0,8,0" />
            <Button x:Name="SaveButton" Grid.Column="2" Style="{StaticResource Button.Primary}" Content="获取并保存此版本" IsEnabled="False" Click="OnSave" />
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="4">
                <Grid>
                    <ListBox x:Name="Results" BorderThickness="0" Background="Transparent" SelectionChanged="OnSelect"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,4">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Text="{Binding Line2}" Style="{StaticResource Text.Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Text="{Binding Line3}" Style="{StaticResource Text.Muted}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="ResultsEmpty" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" MaxWidth="300" />
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="PreviewText" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
