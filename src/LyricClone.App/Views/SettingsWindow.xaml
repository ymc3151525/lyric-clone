<Window x:Class="LyricClone.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:LyricClone.App"
        xmlns:lyrics="clr-namespace:LyricClone.App.Lyrics"
        Style="{StaticResource AppWindow}"
        Title="设置 — lyric-clone"
        KeyboardNavigation.TabNavigation="Cycle"
        Width="960" Height="680" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Text.Subtitle}">
            <Setter Property="Margin" Value="0,24,0,8" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="{StaticResource Type.Body.Size}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="{StaticResource Radius.Md}" Padding="{TemplateBinding Padding}" Background="Transparent" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.HoverOverlay}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Title}" Text="设置" Margin="12,0,0,16" />
                <ListBox x:Name="Nav" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="OnNav" AutomationProperties.Name="设置分类">
                    <ListBoxItem Content="{app:Loc 常规, General}" Tag="General" IsSelected="True" />
                    <ListBoxItem Content="{app:Loc 歌词, Lyrics}" Tag="Lyrics" />
                    <ListBoxItem Content="{app:Loc 按应用, Per app}" Tag="Apps" />
                    <ListBoxItem Content="{app:Loc 视图, Views}" Tag="Views" />
                    <ListBoxItem Content="{app:Loc 快捷键, Hotkeys}" Tag="Hotkeys" />
                    <ListBoxItem Content="{app:Loc 支持, Support}" Tag="Support" />
                    <ListBoxItem Content="{app:Loc 关于, About}" Tag="About" />
                </ListBox>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="32,20,32,32" MaxWidth="720" HorizontalAlignment="Left">

                <!-- 常规 -->
                <StackPanel x:Name="GeneralPage">
                    <TextBlock Style="{StaticResource Text.Title}" Text="常规" />

                    <TextBlock Style="{StaticResource Section}" Text="语言" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Body}" Text="界面语言" />
                            <TextBlock Style="{StaticResource Hint}" Text="切换后立即生效。部分已打开的窗口可能需要关掉再开。" />
                        </StackPanel>
                        <ComboBox x:Name="LanguageBox" Grid.Column="1" SelectionChanged="OnLanguageChanged" AutomationProperties.Name="界面语言">
                            <ComboBoxItem Content="跟随系统" />
                            <ComboBoxItem Content="简体中文" />
                            <ComboBoxItem Content="English" />
                        </ComboBox>
                    </Grid>

                    <TextBlock Style="{StaticResource Section}" Text="外观" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Body}" Text="颜色模式" />
                            <TextBlock Style="{StaticResource Hint}" Text="窗口和设置页的浅色 / 深色。歌词颜色在「视图」里单独设置。" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeBox" Grid.Column="1" SelectionChanged="OnThemeChanged" AutomationProperties.Name="颜色模式">
                            <ComboBoxItem Content="跟随系统（默认）" />
                            <ComboBoxItem Content="浅色" />
                            <ComboBoxItem Content="深色" />
                        </ComboBox>
                    </Grid>

                    <TextBlock Style="{StaticResource Section}" Text="启动" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Body}" Text="开机时启动" />
                            <TextBlock x:Name="AutostartHint" Style="{StaticResource Hint}" Text="登录 Windows 后自动在通知区域运行。也可以在 Windows 的「启动应用」里关闭。" />
                        </StackPanel>
                        <CheckBox x:Name="AutostartBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="16,0,0,0"
                                  Click="OnAutostartToggle" AutomationProperties.Name="开机时启动" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Body}" Text="没有检测到播放器时提示" />
                            <TextBlock Style="{StaticResource Hint}" Text="手动打开软件约 10 秒后还没有任何播放器时，弹出说明。开机自动启动时不提示。" />
                        </StackPanel>
                        <CheckBox x:Name="NoPlayerHintBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="16,0,0,0"
                                  Click="OnGeneralToggle" AutomationProperties.Name="没有检测到播放器时提示" />
                    </Grid>

                    <TextBlock Style="{StaticResource Section}" Text="播放与同步" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Body}" Text="设备延迟" />
                            <TextBlock Style="{StaticResource Hint}" Text="用蓝牙耳机等有延迟的设备时，让歌词整体晚一些出现。正数更晚，负数更早。" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBox x:Name="DeviceDelayBox" Width="96" TextAlignment="Right" FontFamily="{StaticResource Font.Mono}"
                                     LostKeyboardFocus="OnDeviceDelayCommit" KeyDown="OnNumberKey" AutomationProperties.Name="设备延迟毫秒数" />
                            <TextBlock Style="{StaticResource Text.Body}" Text="ms" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Body}" Text="时间轴平滑" />
                            <TextBlock Style="{StaticResource Hint}" Text="播放器上报的进度不稳定时，忽略小的回跳并缓慢追上，避免歌词抖动。" />
                        </StackPanel>
                        <CheckBox x:Name="SmoothingBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="16,0,0,0"
                                  Click="OnGeneralToggle" AutomationProperties.Name="时间轴平滑" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Body}" Text="读取浏览器里的播放" />
                            <TextBlock Style="{StaticResource Hint}" Text="默认忽略浏览器中的视频和网页播放器。开启后，新出现的浏览器会被默认启用。" />
                        </StackPanel>
                        <CheckBox x:Name="BrowsersBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="16,0,0,0"
                                  Click="OnGeneralToggle" AutomationProperties.Name="读取浏览器里的播放" />
                    </Grid>

                    <TextBlock Style="{StaticResource Section}" Text="备份" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="导出设置…" Click="OnExport" Margin="0,0,8,0" />
                        <Button Content="导入设置…" Click="OnImport" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.Subtle}" Content="打开数据文件夹" Click="OnOpenDataFolder" />
                    </StackPanel>
                </StackPanel>

                <!-- 歌词 -->
                <StackPanel x:Name="LyricsPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Text.Title}" Text="歌词" />

                    <TextBlock Style="{StaticResource Section}" Text="来源顺序" />
                    <TextBlock Style="{StaticResource Hint}" Text="没有固定版本时，按这个顺序使用已保存的歌词，都没有时再依次查找。按应用的设置可以覆盖它。" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="4">
                            <ListBox x:Name="SourceOrderList" BorderThickness="0" Background="Transparent" Height="176" DisplayMemberPath="Label" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <Button Content="上移" MinWidth="72" Margin="0,0,0,8" Click="OnSourceUp" />
                            <Button Content="下移" MinWidth="72" Click="OnSourceDown" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource Section}" Text="检索与保存" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Body}" Text="版本选择" />
                            <TextBlock Style="{StaticResource Hint}" Text="有多个已保存版本时怎么挑。固定和已确认的版本始终优先。" />
                        </StackPanel>
                        <ComboBox x:Name="VersionPickBox" Grid.Column="1" SelectionChanged="OnVersionPickChanged" AutomationProperties.Name="版本选择">
                            <ComboBoxItem Content="按来源顺序" />
                            <ComboBoxItem Content="按来源顺序，否则选同步更好的" />
                        </ComboBox>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Body}" Text="自动保存曲目和歌词" />
                            <TextBlock Style="{StaticResource Hint}" Text="关闭后不再联网查找或写入曲目库，已经保存的内容仍可手动管理。" />
                        </StackPanel>
                        <CheckBox x:Name="AutoManageBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="16,0,0,0"
                                  Click="OnLyricsContentToggle" AutomationProperties.Name="自动保存曲目和歌词" />
                    </Grid>

                    <TextBlock Style="{StaticResource Section}" Text="歌词显示" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Body}" Text="显示中文翻译" />
                            <TextBlock Style="{StaticResource Hint}" Text="各视图还可以单独关掉翻译。这里关掉则所有视图都不显示。" />
                        </StackPanel>
                        <CheckBox x:Name="ChineseTranslationBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="16,0,0,0"
                                  Click="OnLyricsContentToggle" AutomationProperties.Name="显示中文翻译" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Body}" Text="罗马音" />
                            <TextBlock Style="{StaticResource Hint}" Text="歌词里有日文假名时，在翻译行附上罗马音。不含汉字读音。" />
                        </StackPanel>
                        <ComboBox x:Name="RomajiBox" Grid.Column="1" SelectionChanged="OnRomajiChanged" AutomationProperties.Name="罗马音">
                            <ComboBoxItem Content="不显示" />
                            <ComboBoxItem Content="显示" />
                        </ComboBox>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Body}" Text="优先简体中文" />
                            <TextBlock Style="{StaticResource Hint}" Text="把繁体字转成简体后再显示。重新加载或切歌后生效。" />
                        </StackPanel>
                        <CheckBox x:Name="SimplifiedBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="16,0,0,0"
                                  Click="OnLyricsContentToggle" AutomationProperties.Name="优先简体中文" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Body}" Text="拆开过长的中文行" />
                            <TextBlock Style="{StaticResource Hint}" Text="遇到逗号、句号等标点时把很长的一行分成多行。刷新歌词后生效。" />
                        </StackPanel>
                        <CheckBox x:Name="SplitLinesBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="16,0,0,0"
                                  Click="OnLyricsContentToggle" AutomationProperties.Name="拆开过长的中文行" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Body}" Text="显示脏词" />
                            <TextBlock Style="{StaticResource Hint}" Text="关闭后，常见脏词会显示成星号。" />
                        </StackPanel>
                        <CheckBox x:Name="ExplicitBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="16,0,0,0"
                                  Click="OnLyricsContentToggle" AutomationProperties.Name="显示脏词" />
                    </Grid>

                    <TextBlock Style="{StaticResource Section}" Text="在线来源" />
                    <TextBlock Style="{StaticResource Hint}" Text="优先读取本机 QQ / 网易云 / 酷狗已经缓存的歌词文件，再查本地文件夹、音频内嵌和公开的 LRCLIB。不会调用这些播放器未公开的网络接口。" Margin="0,0,0,8" />

                    <TextBlock Style="{StaticResource Section}" Text="本地歌词文件夹" />
                    <TextBlock Style="{StaticResource Hint}" Text="放 .lrc、.ttml、.qrc、.krc、.yrc、.lys、.lyl 文件，文件名写「歌名」或「艺人 - 歌名」即可自动匹配。" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderBox" IsReadOnly="True" AutomationProperties.Name="本地歌词文件夹" />
                        <Button Grid.Column="1" Content="选择…" Margin="8,0,0,0" Click="OnPickFolder" />
                        <Button Grid.Column="2" Style="{StaticResource Button.Subtle}" Content="清除" Margin="4,0,0,0" Click="OnClearFolder" />
                    </Grid>

                    <TextBlock Style="{StaticResource Section}" Text="音乐文件夹（内嵌歌词）" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="读取这个文件夹里 MP3、FLAC、M4A 文件自带的歌词，按标签里的歌名和艺人匹配正在播放的歌。不设置时使用系统的「音乐」文件夹。" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="MusicFolderBox" IsReadOnly="True" AutomationProperties.Name="音乐文件夹" />
                        <Button Grid.Column="1" Content="选择…" Margin="8,0,0,0" Click="OnPickMusicFolder" />
                        <Button Grid.Column="2" Style="{StaticResource Button.Subtle}" Content="使用默认" Margin="4,0,0,0" Click="OnClearMusicFolder" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="ScanMusicButton" Content="重新扫描" Click="OnScanMusic" />
                        <TextBlock x:Name="MusicScanText" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Body}" Text="自动更新已保存的在线歌词" />
                            <TextBlock Style="{StaticResource Hint}" Text="未固定的 LRCLIB 版本超过 7 天后再播放时，会再查一次并覆盖缓存。固定和已确认的版本不会动。" />
                        </StackPanel>
                        <CheckBox x:Name="AutoUpdateBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="16,0,0,0"
                                  Click="OnAutoUpdateToggle" AutomationProperties.Name="自动更新已保存的在线歌词" />
                    </Grid>

                    <TextBlock Style="{StaticResource Section}" Text="曲目库" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="打开全部曲目" Click="OnOpenLibrary" />
                    </StackPanel>
                </StackPanel>

                <!-- 视图 -->
                <StackPanel x:Name="ViewsPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Text.Title}" Text="视图" />
                    <TextBlock Style="{StaticResource Hint}" Text="改字号、翻译、两行或描边时，下面这行会跟着变。用的是桌面歌词那一组。" Margin="0,8,0,8" />
                    <Border Style="{StaticResource Card}" Padding="20,16" Background="{StaticResource Brush.Lyric.OverlayBg}" Margin="0,0,0,8">
                        <StackPanel>
                            <lyrics:LyricLineView x:Name="ViewPreviewCurrent" FontSize="32" FontWeight="SemiBold"
                                                  FontFamily="{StaticResource Font.Sans}"
                                                  TextBrush="{StaticResource Brush.Lyric.Text}"
                                                  SungBrush="{StaticResource Brush.Lyric.Sung}"
                                                  DimBrush="{StaticResource Brush.Lyric.Dim}"
                                                  TranslationBrush="{StaticResource Brush.Lyric.Translation}"
                                                  StrokeBrush="{StaticResource Brush.Lyric.Stroke}"
                                                  OutlineThickness="{StaticResource Lyric.OutlineThickness}"
                                                  ShowTranslation="True" />
                            <lyrics:LyricLineView x:Name="ViewPreviewNext" FontSize="24" Margin="0,8,0,0" IsActive="False"
                                                  FontFamily="{StaticResource Font.Sans}"
                                                  TextBrush="{StaticResource Brush.Lyric.Text}"
                                                  SungBrush="{StaticResource Brush.Lyric.Sung}"
                                                  DimBrush="{StaticResource Brush.Lyric.Dim}"
                                                  TranslationBrush="{StaticResource Brush.Lyric.Translation}"
                                                  StrokeBrush="{StaticResource Brush.Lyric.Stroke}"
                                                  OutlineThickness="{StaticResource Lyric.OutlineThickness}"
                                                  ShowTranslation="True" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ViewTranslationHint" Style="{StaticResource Hint}" Visibility="Collapsed"
                               Text="先打开显示中文翻译" Margin="0,0,0,8" />

                    <TextBlock Style="{StaticResource Section}" Text="桌面歌词" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Body}" Text="显示桌面歌词" VerticalAlignment="Center" />
                        <CheckBox x:Name="DesktopEnabledBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Click="OnViewsToggle" AutomationProperties.Name="显示桌面歌词" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Body}" Text="锁定（鼠标可以穿透）" VerticalAlignment="Center" />
                        <CheckBox x:Name="DesktopLockedBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Click="OnViewsToggle" AutomationProperties.Name="锁定桌面歌词" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Body}" Text="字体" VerticalAlignment="Center" />
                        <ComboBox x:Name="DesktopFontBox" Grid.Column="1" IsEditable="True" IsTextSearchEnabled="True"
                                  LostKeyboardFocus="OnFontCommit" SelectionChanged="OnFontCommit" AutomationProperties.Name="桌面歌词字体" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Body}" Text="字号" VerticalAlignment="Center" />
                        <Slider x:Name="DesktopSizeSlider" Grid.Column="1" Minimum="16" Maximum="72" TickFrequency="2" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" ValueChanged="OnSizeChanged" AutomationProperties.Name="桌面歌词字号" />
                        <TextBlock x:Name="DesktopSizeText" Grid.Column="2" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" TextAlignment="Right" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Body}" Text="对齐" VerticalAlignment="Center" />
                        <ComboBox x:Name="DesktopAlignBox" Grid.Column="1" SelectionChanged="OnAlignChanged" AutomationProperties.Name="桌面歌词对齐">
                            <ComboBoxItem Content="左对齐" />
                            <ComboBoxItem Content="居中" />
                            <ComboBoxItem Content="右对齐" />
                        </ComboBox>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Body}" Text="显示两行（当前行和下一行）" VerticalAlignment="Center" />
                        <CheckBox x:Name="DesktopTwoLinesBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Click="OnViewsToggle" AutomationProperties.Name="显示两行" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Body}" Text="显示翻译" VerticalAlignment="Center" />
                        <CheckBox x:Name="DesktopTranslationBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Click="OnViewsToggle" AutomationProperties.Name="桌面歌词显示翻译" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Body}" Text="文字描边" VerticalAlignment="Center" />
                        <CheckBox x:Name="DesktopOutlineBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Click="OnViewsToggle" AutomationProperties.Name="文字描边" />
                    </Grid>
                    <StackPanel x:Name="DesktopColorsPanel" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Style="{StaticResource Button.Subtle}" Content="把桌面歌词移回默认位置" Click="OnResetDesktopPosition" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Section}" Text="灵动词岛" />
                    <TextBlock Style="{StaticResource Hint}" Text="宽度跟着歌词走。太长会左右来回滚。贴在右边时左边会跟着伸缩。可拖到屏幕边缘；贴在四角时会留下耳朵。封面固定在最左边。" Margin="0,0,0,4" />
                    <Grid Style="{StaticResource Row}">
