                               Text="这个个人构建默认没有发布地址。如果你自己托管了一个版本信息 JSON（version / url / notes），可以填在下面。" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="UpdateFeedBox" AutomationProperties.Name="更新源地址"
                                 LostKeyboardFocus="OnUpdateFeedCommit" />
                        <Button x:Name="CheckUpdateButton" Grid.Column="1" Content="检查更新" Margin="8,0,0,0" Click="OnCheckUpdate" />
                    </Grid>
                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
