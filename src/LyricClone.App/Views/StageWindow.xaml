<Window x:Class="LyricClone.App.Views.StageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lyrics="clr-namespace:LyricClone.App.Lyrics"
        Title="歌词舞台 — lyric-clone"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Background="#FF0B0B0E" UseLayoutRounding="True"
        KeyboardNavigation.TabNavigation="Cycle"
        AutomationProperties.Name="歌词舞台">
    <Grid x:Name="Root" ClipToBounds="True" Background="Transparent">
        <Rectangle x:Name="Backdrop">
            <Rectangle.Fill>
                <LinearGradientBrush x:Name="Wash" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="StopA" Color="#FF141822" Offset="0" />
                    <GradientStop x:Name="StopB" Color="#FF1C1422" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <StackPanel x:Name="LinesColumn" VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="1100" Margin="48">
            <lyrics:LyricLineView x:Name="PrevLine" FontSize="28" FontWeight="SemiBold"
                                  TextAlignment="Center" Margin="0,0,0,28" Opacity="0.45"
                                  AutomationProperties.Name="上一行" />
            <lyrics:LyricLineView x:Name="CurrentLine" FontWeight="Bold" TextAlignment="Center"
                                  AutomationProperties.Name="当前歌词" />
            <lyrics:LyricLineView x:Name="NextLine" FontSize="28" FontWeight="SemiBold"
                                  TextAlignment="Center" Margin="0,28,0,0" Opacity="0.45"
                                  AutomationProperties.Name="下一行" />
            <TextBlock x:Name="EmptyText" Foreground="#B3FFFFFF" FontSize="28" TextWrapping="Wrap"
                       TextAlignment="Center" Visibility="Collapsed" />
        </StackPanel>

        <Button x:Name="CloseButton" Style="{StaticResource Button.Icon}" Foreground="White" Width="40" Height="40"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
                ToolTip="退出舞台（Esc 或双击）" AutomationProperties.Name="退出歌词舞台" Click="OnClose">
            <Path Data="{StaticResource Icon.Close}" Style="{StaticResource IconPath}" />
        </Button>
    </Grid>
</Window>
