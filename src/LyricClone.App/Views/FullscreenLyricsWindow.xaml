<Window x:Class="LyricClone.App.Views.FullscreenLyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="全屏歌词 — lyric-clone"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Background="#FF101114" UseLayoutRounding="True">
    <Grid x:Name="Root" ClipToBounds="True">
        <Rectangle x:Name="Fallback">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF1E2433" Offset="0" />
                    <GradientStop Color="#FF2A1F33" Offset="0.55" />
                    <GradientStop Color="#FF101114" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Image x:Name="Backdrop" Stretch="UniformToFill" Margin="-120" Visibility="Collapsed">
            <Image.Effect>
                <BlurEffect Radius="96" KernelType="Gaussian" RenderingBias="Performance" />
            </Image.Effect>
        </Image>
        <Rectangle Fill="#A6000000" />

        <Grid Margin="72,56">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                <Border x:Name="CoverFrame" Width="380" Height="380" CornerRadius="18" Background="#33FFFFFF" Effect="{StaticResource Shadow.Pop}">
                    <Grid>
                        <Path x:Name="CoverPlaceholder" Data="M9,18 V5 L21,3 V16 M9,18 A3,3 0 1 1 3,18 A3,3 0 1 1 9,18 M21,16 A3,3 0 1 1 15,16 A3,3 0 1 1 21,16"
                              Stroke="#66FFFFFF" StrokeThickness="1.2" Width="96" Height="96" Stretch="Uniform" />
                        <Border CornerRadius="18" ClipToBounds="True">
                            <Border.OpacityMask>
                                <VisualBrush>
                                    <VisualBrush.Visual>
                                        <Border Width="380" Height="380" CornerRadius="18" Background="Black" />
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Border.OpacityMask>
                            <Image x:Name="Cover" Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                </Border>
                <TextBlock x:Name="TitleText" Margin="0,28,0,0" Foreground="White" FontSize="28" FontWeight="SemiBold"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="80" />
                <TextBlock x:Name="ArtistText" Margin="0,6,0,0" Foreground="#B3FFFFFF" FontSize="18" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Style="{StaticResource Button.Icon}" Foreground="White" Width="44" Height="44"
                            ToolTip="上一首" AutomationProperties.Name="上一首" Click="OnPrevious">
                        <Path Data="M18,6 L9,12 L18,18 Z M7,6 V18" Style="{StaticResource IconPath}" />
                    </Button>
                    <Button x:Name="PlayPauseButton" Style="{StaticResource Button.Icon}" Foreground="White" Width="44" Height="44" Margin="8,0"
                            ToolTip="播放 / 暂停" AutomationProperties.Name="播放或暂停" Click="OnPlayPause">
                        <Path Data="M8,5 V19 M16,5 V19" Style="{StaticResource IconPath}" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Foreground="White" Width="44" Height="44"
                            ToolTip="下一首" AutomationProperties.Name="下一首" Click="OnNext">
                        <Path Data="M6,6 L15,12 L6,18 Z M17,6 V18" Style="{StaticResource IconPath}" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <Grid x:Name="Viewport" Grid.Column="2" ClipToBounds="True" Background="Transparent" MouseWheel="OnWheel">
                <Grid.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="0.14" />
                        <GradientStop Color="#FF000000" Offset="0.82" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Grid.OpacityMask>
                <StackPanel x:Name="LinesPanel" VerticalAlignment="Top">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="Scroll" />
                    </StackPanel.RenderTransform>
                </StackPanel>
                <TextBlock x:Name="EmptyText" Foreground="#B3FFFFFF" FontSize="24" TextWrapping="Wrap"
                           VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Grid>

        <Button x:Name="CloseButton" Style="{StaticResource Button.Icon}" Foreground="White" Width="40" Height="40"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
                ToolTip="退出全屏（Esc）" AutomationProperties.Name="退出全屏歌词" Click="OnClose">
            <Path Data="{StaticResource Icon.Close}" Style="{StaticResource IconPath}" />
        </Button>
    </Grid>
</Window>
