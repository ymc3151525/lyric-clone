<Window x:Class="LyricClone.App.Views.DesignGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lyrics="clr-namespace:LyricClone.App.Lyrics"
        Title="设计预览" Style="{StaticResource AppWindow}"
        Width="960" Height="760" WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Page" Margin="{StaticResource Pad.Page}">
            <TextBlock Style="{StaticResource Text.Title}" Text="设计预览" />
            <TextBlock Margin="0,4,0,24" Style="{StaticResource Text.Muted}" Text="基础控件与歌词渲染。示例文字均为虚构。" />

            <TextBlock Style="{StaticResource Text.Subtitle}" Text="按钮" />
            <WrapPanel Margin="0,8,0,24">
                <Button Style="{StaticResource Button.Primary}" Content="固定" Margin="0,0,8,8" />
                <Button Style="{StaticResource Button.Secondary}" Content="标记为正确" Margin="0,0,8,8" />
                <Button Style="{StaticResource Button.Subtle}" Content="恢复自动" Margin="0,0,8,8" />
                <Button Style="{StaticResource Button.Danger}" Content="删除此版本" Margin="0,0,8,8" />
                <Button Style="{StaticResource Button.Primary}" Content="不可用" IsEnabled="False" Margin="0,0,8,8" />
                <Button Style="{StaticResource Button.Icon}" ToolTip="设置" AutomationProperties.Name="设置" Margin="0,0,8,8">
                    <Path Data="{StaticResource Icon.Settings}" Style="{StaticResource IconPath}" />
                </Button>
                <Button Style="{StaticResource Button.Icon}" ToolTip="搜索" AutomationProperties.Name="搜索" Margin="0,0,8,8">
                    <Path Data="{StaticResource Icon.Search}" Style="{StaticResource IconPath}" />
                </Button>
            </WrapPanel>

            <TextBlock Style="{StaticResource Text.Subtitle}" Text="输入与开关" />
            <StackPanel Margin="0,8,0,24" Orientation="Horizontal">
                <TextBox Width="260" Text="搜索歌名、艺人或专辑" Margin="0,0,16,0" />
                <CheckBox Style="{StaticResource ToggleSwitch}" Content="显示翻译" IsChecked="True" Margin="0,0,16,0" />
                <CheckBox Style="{StaticResource ToggleSwitch}" Content="跟随播放" />
            </StackPanel>

            <TextBlock Style="{StaticResource Text.Subtitle}" Text="卡片与标签" />
            <Border Style="{StaticResource Card}" Margin="0,8,0,24">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="示例曲目 — 示例艺人" />
                    <TextBlock Style="{StaticResource Text.Muted}" Text="LRCLIB · 已保存" Margin="0,2,0,8" />
                    <WrapPanel>
                        <Border Style="{StaticResource Badge}"><TextBlock Style="{StaticResource Text.Muted}" Text="逐行" /></Border>
                        <Border Style="{StaticResource Badge}"><TextBlock Style="{StaticResource Text.Muted}" Text="逐字" /></Border>
                        <Border Style="{StaticResource Badge}"><TextBlock Style="{StaticResource Text.Muted}" Text="翻译" /></Border>
                        <Border Style="{StaticResource Badge}" Background="{DynamicResource Brush.Accent}">
                            <TextBlock Style="{StaticResource Text.Muted}" Foreground="{DynamicResource Brush.OnAccent}" Text="使用中" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Text.Subtitle}" Text="歌词渲染" />
            <Border Margin="0,8,0,0" CornerRadius="{StaticResource Radius.Lg}" Background="#3A4A6B" Padding="24">
                <StackPanel>
                    <lyrics:LyricLineView x:Name="WordLine" FontSize="32"
                                          FontFamily="{StaticResource Font.Display}"
                                          TextBrush="{StaticResource Brush.Lyric.Text}"
                                          SungBrush="{StaticResource Brush.Lyric.Sung}"
                                          TranslationBrush="{StaticResource Brush.Lyric.Translation}"
                                          StrokeBrush="{StaticResource Brush.Lyric.Stroke}"
                                          OutlineThickness="{StaticResource Lyric.OutlineThickness}" />
                    <lyrics:LyricLineView x:Name="NextSample" FontSize="24" Margin="0,8,0,0" IsActive="False"
                                          FontFamily="{StaticResource Font.Display}"
                                          DimBrush="{StaticResource Brush.Lyric.Dim}"
                                          StrokeBrush="{StaticResource Brush.Lyric.Stroke}"
                                          OutlineThickness="{StaticResource Lyric.OutlineThickness}" />
                </StackPanel>
            </Border>
            <Border Margin="0,12,0,0" HorizontalAlignment="Center" Height="56" Padding="20,12"
                    CornerRadius="{StaticResource Radius.Island}" Background="{StaticResource Brush.Lyric.OverlayBg}">
                <lyrics:LyricLineView x:Name="IslandSample" FontSize="{StaticResource Lyric.Island.Size}" VerticalAlignment="Center" ShowTranslation="False"
                                      FontWeight="SemiBold" FontFamily="{StaticResource Font.Sans}"
                                      TextBrush="{StaticResource Brush.Lyric.Text}" SungBrush="{StaticResource Brush.Lyric.Sung}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
