<Application x:Class="LyricClone.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LyricClone.App"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.Light.xaml" />
                <ResourceDictionary Source="Themes/Tokens.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <local:TrackSubtitleConverter x:Key="TrackSubtitle" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
