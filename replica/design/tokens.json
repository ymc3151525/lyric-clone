{
  "_about": "Design tokens for lyric-clone. Roles, not brand: accent is a neutral placeholder until /replica-brand. No screenshots of the original were used; values follow common Windows 11 desktop conventions. Source of truth for src/LyricClone.App/Themes/*.xaml. Check with: python3 contrast.py replica/design/tokens.json",
  "color": {
    "bg": "#f6f7f9",
    "surface": "#ffffff",
    "surface-alt": "#eef0f3",
    "border": "#dfe2e7",
    "border-input": "#7b818b",
    "text": "#16181d",
    "text-muted": "#5a616c",
    "accent": "#3b5bdb",
    "on-accent": "#ffffff",
    "danger": "#b42318",
    "success": "#0f7a3d",
    "warning": "#8a5300",

    "dark-bg": "#1b1c20",
    "dark-surface": "#25272c",
    "dark-surface-alt": "#2e3036",
    "dark-border": "#3a3d44",
    "dark-border-input": "#8a909a",
    "dark-text": "#f2f3f5",
    "dark-text-muted": "#a6acb6",
    "dark-accent": "#8ea4ff",
    "dark-on-accent": "#10142a",
    "dark-danger": "#ff8c82",
    "dark-success": "#62d295",
    "dark-warning": "#f0c46a",

    "lyric-overlay-bg": "#0b0b0e",
    "lyric-text": "#ffffff",
    "lyric-sung": "#9fb2ff",
    "lyric-dim": "#8b8b93",
    "lyric-translation": "#c3c3cb",
    "lyric-stroke": "#000000"
  },
  "pairs": [
    ["text", "bg"],
    ["text", "surface"],
    ["text", "surface-alt"],
    ["text-muted", "bg"],
    ["text-muted", "surface"],
    ["text-muted", "surface-alt"],
    ["on-accent", "accent"],
    ["accent", "surface"],
    ["accent", "bg"],
    ["danger", "surface"],
    ["success", "surface"],
    ["warning", "surface"],
    ["border-input", "surface", "ui"],
    ["border-input", "bg", "ui"],
    ["accent", "surface", "ui"],

    ["dark-text", "dark-bg"],
    ["dark-text", "dark-surface"],
    ["dark-text", "dark-surface-alt"],
    ["dark-text-muted", "dark-bg"],
    ["dark-text-muted", "dark-surface"],
    ["dark-text-muted", "dark-surface-alt"],
    ["dark-on-accent", "dark-accent"],
    ["dark-accent", "dark-surface"],
    ["dark-danger", "dark-surface"],
    ["dark-success", "dark-surface"],
    ["dark-warning", "dark-surface"],
    ["dark-border-input", "dark-surface", "ui"],
    ["dark-accent", "dark-surface", "ui"],

    ["lyric-text", "lyric-overlay-bg"],
    ["lyric-sung", "lyric-overlay-bg"],
    ["lyric-dim", "lyric-overlay-bg"],
    ["lyric-translation", "lyric-overlay-bg"],
    ["lyric-text", "lyric-stroke", "large"],
    ["lyric-sung", "lyric-stroke", "large"]
  ],
  "font": {
    "sans": "Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, sans-serif",
    "display": "Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI, sans-serif",
    "mono": "Cascadia Mono, Consolas, monospace",
    "_note": "System fonts present on Windows 10/11, referenced not redistributed. Custom font per lyric view is a user setting."
  },
  "type": {
    "caption":   {"size": 12, "line": 16, "weight": 400},
    "body":      {"size": 14, "line": 20, "weight": 400},
    "body-strong": {"size": 14, "line": 20, "weight": 600},
    "subtitle":  {"size": 20, "line": 28, "weight": 600},
    "title":     {"size": 28, "line": 36, "weight": 600},
    "display":   {"size": 40, "line": 52, "weight": 700}
  },
  "lyric-type": {
    "island":            {"size": 15, "weight": 600},
    "island-expanded":   {"size": 17, "weight": 600},
    "taskbar":           {"size": 13, "weight": 600},
    "desktop":           {"size": 32, "weight": 700, "min": 16, "max": 96},
    "desktop-translation": {"ratio": 0.6, "weight": 500},
    "fullscreen-current": {"size": 40, "weight": 700},
    "fullscreen-other":  {"size": 32, "weight": 700, "opacity": 0.35},
    "stage":             {"size": 56, "weight": 800}
  },
  "space": [0, 4, 8, 12, 16, 24, 32, 48, 64],
  "radius": {"sm": 4, "md": 8, "lg": 12, "pill": 999, "island": 18},
  "shadow": {
    "card": {"blur": 4, "depth": 1, "opacity": 0.08},
    "pop":  {"blur": 24, "depth": 8, "opacity": 0.18},
    "lyric-glow": {"blur": 8, "depth": 0, "opacity": 0.6}
  },
  "stroke": {"lyric-outline": 1.5},
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "line-scroll": "420ms",
    "island-resize": "360ms",
    "ease": "cubic-bezier(.2,.8,.2,1)",
    "ease-wpf": "ExponentialEase EaseOut Exponent=6",
    "syllable": "linear over the syllable's own duration",
    "reduced": "respect SystemParameters.ClientAreaAnimation = false: no scroll easing, instant line swap"
  },
  "layout": {
    "settings-window": {"width": 960, "height": 640, "min-width": 760, "min-height": 520, "nav-width": 240},
    "manager-window": {"width": 1120, "height": 720, "min-width": 880, "min-height": 560, "track-list-width": 320, "sources-width": 300},
    "island": {"top-offset": 8, "height": 36, "height-expanded": 64, "min-width": 160, "max-width": 560, "padding-x": 14},
    "desktop-lyrics": {"default-anchor": "bottom-center", "default-bottom-margin-ratio": 0.12, "hover-toolbar-height": 32},
    "taskbar-lyrics": {"padding-x": 12, "cover-size": 24},
    "fullscreen": {"cover-size": 320, "lyrics-column-max-width": 820, "background-blur": 80}
  }
}
